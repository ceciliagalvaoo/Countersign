# Copy this file to .env and fill in the values. Never commit .env.

# Base URL of the API, including the /api prefix.
# Defaults to http://localhost:3001/api when not set.
VITE_API_URL="http://localhost:3001/api"

# Base URL of apps/agent (Countersign agent service). Defaults to http://localhost:3002 when not set.
VITE_AGENT_URL="http://localhost:3002"
