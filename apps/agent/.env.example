# Countersign agent service (apps/agent). Copy to .env and fill in. Never commit .env.

# Anthropic API key (console.anthropic.com). Only this service reads it; it never reaches the browser.
ANTHROPIC_API_KEY=""

# Claude model used by the agent. Empty means the default, claude-opus-5-5 (see projeto/08-BUILD-PROMPT.md, Stack)
AGENT_MODEL=""

# Countersign API (apps/api), for example http://localhost:3001/api
API_BASE_URL=""

# Port of this service (default 3002)
PORT=""

# Optional. Browser origin of apps/new_web allowed by CORS (default http://localhost:5173)
CORS_ORIGIN=""

# Optional. Where session dumps are written (default apps/agent/sessions, gitignored)
AGENT_SESSIONS_DIR=""

# Optional. Demo catalog with fixed per fund texts (default ../api/scripts/countersign-demo-funds.json)
DEMO_CATALOG_PATH=""
