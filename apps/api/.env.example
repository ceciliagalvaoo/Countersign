# Copy this file to .env and fill in the values. Never commit .env.

# PostgreSQL connection string (Supabase, Neon, Render, AWS RDS, local Docker...)
# Supabase: use the "Transaction pooler" URI (port 6543) and append ?pgbouncer=true
# (the "Direct connection" host is IPv6-only and often fails from WSL/home networks)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Direct (non-pooled) connection used by Prisma migrations.
# Same as DATABASE_URL unless you connect through a pooler like PgBouncer.
# Supabase: use the "Session pooler" URI (port 5432).
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=""

# Required. Encrypts the agent signing keys at rest (AES-256-GCM). 32 bytes as 64 hex characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_KEY_ENCRYPTION_SECRET=

# Port the API listens on (hosting providers like Render set this automatically)
PORT=3001

# Set to "false" only when the API is exposed directly, without a reverse proxy
# TRUST_PROXY="true"

# Allowed frontend origins, comma-separated (e.g. http://localhost:5173,https://your-app.vercel.app)
CORS_ORIGIN="*"

# Soroban contracts deployed by contracts/scripts/deploy-testnet.sh
FUND_TOKEN_CONTRACT_ID=""
# Uploaded FundToken Wasm hash (written by deploy-testnet.sh); each fund deploys its own share token from it
FUND_TOKEN_WASM_HASH=""
# Uploaded MandateWallet Wasm hash (written by contracts/scripts/upload-mandate-wallet.sh); each investor deploys her own agent wallet from it
MANDATE_WALLET_WASM_HASH=""
RECEIVABLE_VAULT_CONTRACT_ID=""
STELLAR_ADMIN_ADDRESS=""

# Asset used for investments and refunds (default: Blend testnet USDC, so it can be supplied to the Blend pool)
# PAYMENT_ASSET_CODE="USDC"
# PAYMENT_ASSET_ISSUER="GATALTGTWIOT6BUDBCZM3Q4OQ4BO2COLOAZ7IYSKPLC2PMSOPPGF5V56"

# ZK investor badges (written by deploy-testnet.sh): BadgeVerifier contract and the platform attestation key.
# The attester secret only signs commitments (it holds no funds) but must stay private: rotate with set_attester.
BADGE_VERIFIER_CONTRACT_ID=""
BADGE_ATTESTER_SECRET=""

# Soroban RPC endpoint (empty = public testnet RPC https://soroban-testnet.stellar.org). Set a provider URL if the
# public RPC is rate limited; the adversarial suite points it to an unreachable URL (A12, RPC unavailable).
SOROBAN_RPC_URL=""

# Testnet only: secret of an operator account that holds only test XLM and test USDC, used by
# POST /api/stellar/test-usdc-transfer (empty = route answers 404 "not configured"). Never a user key, never mainnet.
TESTNET_USDC_FUNDER_SECRET=""
